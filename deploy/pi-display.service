# Runs the display's web server. setup.sh fills in __USER__ and __DIR__.
[Unit]
Description=Pi Display web server
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
